{
  "name": "requirements-review-agent",
  "version": "0.1.0",
  "description": "Requirements reviewer powered by Codex CLI, with three review perspectives and an eval harness.",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=20" },
  "scripts": {
    "review": "tsx src/index.ts",
    "eval": "tsx eval/run.ts",
    "test": "tsx --test src/mcp/requirements.test.ts src/review.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc"
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
